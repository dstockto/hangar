{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make bundle)",
      "Bash(make verify-assets)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(scripts/test.sh:*)",
      "Bash(shellcheck:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(codesign -dv:*)",
      "Bash(spctl -a:*)",
      "Bash(ssh -F:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh release:*)",
      "Bash(gh api:*)",
      "Bash(make dmg)",
      "Bash(xcrun notarytool:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/sso/cache/**)",
      "Read(~/.ssh/id_*)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/production-gate.sh"
          }
        ]
      }
    ]
  }
}
